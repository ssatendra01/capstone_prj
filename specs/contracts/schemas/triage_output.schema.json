{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearview.example/schemas/triage_output.schema.json",
  "title": "TriageOutput (handshake Triage -> Evidence)",
  "type": "object",
  "required": ["complaint_id", "intent", "confidence", "priority", "sla_hours", "sla_due", "sentiment", "vulnerable",
               "vulnerability_markers", "legal_threat", "route_team", "hours_to_fca_deadline", "deadline_risk", "citations", "reasoning"],
  "properties": {
    "complaint_id": {"type": "string"},
    "intent": {"enum": ["DUPLICATE_CHARGE", "ATM_PAYMENT_FAILURE", "UNAUTHORISED_TXN", "MORTGAGE_LOAN_DISPUTE", "ACCOUNT_CLOSURE", "DATA_PRIVACY", "OTHER"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "priority": {"enum": ["P1", "P2", "P3"]},
    "sla_hours": {"enum": [4, 24, 72]},
    "sla_due": {"type": "string"},
    "sentiment": {"type": "number", "minimum": -1, "maximum": 1},
    "vulnerable": {"type": "boolean"},
    "vulnerability_markers": {"type": "array", "items": {"type": "object", "required": ["id", "source"],
      "properties": {"id": {"type": "string", "pattern": "^cv:Vulnerability/"}, "source": {"enum": ["complaint_text", "crm_dob", "crm_flag"]}}}},
    "legal_threat": {"type": "boolean"},
    "route_team": {"type": "string"},
    "hours_to_fca_deadline": {"type": "number"},
    "deadline_risk": {"type": "boolean"},
    "citations": {"type": "array", "items": {"type": "string", "pattern": "^cv:"}},
    "reasoning": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"vulnerable": {"const": true}}}, "then": {"properties": {"priority": {"const": "P1"}}}},
    {"if": {"properties": {"intent": {"const": "OTHER"}}}, "then": {"properties": {"confidence": {"maximum": 0.5}}}}
  ],
  "additionalProperties": true
}
