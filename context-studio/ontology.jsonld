{
  "@context": {
    "@vocab": "https://clearview.example/ontology#",
    "cv": "https://clearview.example/ontology#",
    "name": "http://schema.org/name",
    "description": "http://schema.org/description",
    "governedBy": {"@type": "@id"},
    "evidenceFrom": {"@type": "@id"},
    "routesTo": {"@type": "@id"},
    "usesSystem": {"@type": "@id"},
    "requiresAuthority": {"@type": "@id"}
  },
  "@graph": [
    {
      "@id": "cv:Bank/Clearview", "@type": "Bank",
      "name": "Clearview Retail Bank plc",
      "description": "UK-regulated retail bank, founded 1882, Edinburgh. 3.2 million customers, 420 branches, 12,400 staff, 38bn GBP assets. Regulators FCA conduct and PRA prudential. Brand voice empathic, legally precise, non-defensive.",
      "customerTiers": ["Standard", "Premier", "Wealth", "SME"],
      "brandVoice": "empathic, legally precise, non-defensive",
      "escalationPaths": ["FOS referral", "Internal Ombudsman"],
      "complaintVolumePerMonth": 50000,
      "vulnerableShare": 0.14
    },

    {"@id": "cv:System/T24", "@type": "System", "name": "Temenos T24 Core Banking", "description": "balances, overdraft, fee ledger, transactions 90 day log", "mcpTable": "transactions"},
    {"@id": "cv:System/CAMS", "@type": "System", "name": "FIS CAMS", "description": "debit and credit authorisations, card disputes, chargebacks, ATM dispense records", "mcpTable": "card_disputes"},
    {"@id": "cv:System/SFDC", "@type": "System", "name": "Salesforce FSC CRM", "description": "case history, interaction log, KYC, vulnerability marker, DSAR cases", "mcpTable": "crm_cases"},
    {"@id": "cv:System/VERINT", "@type": "System", "name": "Verint IVR", "description": "call recordings and speech-to-text transcripts", "mcpTable": "call_transcripts"},
    {"@id": "cv:System/POSTGRES", "@type": "System", "name": "Postgres MCP schema", "description": "normalised complaint, agent run, audit and resolution tables", "mcpTable": "complaints"},

    {"@id": "cv:Rule/DISP-1.4", "@type": "RegulatoryRule", "name": "FCA DISP 1.4 Summary Resolution Communication",
     "description": "Complaint resolved by close of third business day must be followed by a summary resolution communication (SRC). Keywords: SRC, three business days, summary resolution.",
     "deadlineBusinessDays": 3},
    {"@id": "cv:Rule/DISP-1.6", "@type": "RegulatoryRule", "name": "FCA DISP 1.6 Final response within eight weeks",
     "description": "Firm must send a final response or a holding response within eight weeks of receiving a complaint. Eight week statutory deadline. FOS referral rights must be stated.",
     "deadlineWeeks": 8},
    {"@id": "cv:Rule/CONSUMER-DUTY", "@type": "RegulatoryRule", "name": "FCA Consumer Duty",
     "description": "Four outcomes: products and services, price and value, consumer understanding, consumer support. Firms must deliver good outcomes for vulnerable customers and avoid foreseeable harm."},
    {"@id": "cv:Rule/PSR-2017-76", "@type": "RegulatoryRule", "name": "Payment Services Regulations 2017 reg 76 unauthorised payments",
     "description": "Payer refunded for unauthorised payment unless the firm can show fraud or gross negligence by the customer. Unauthorised transaction, fraud, card not present, cardholder not present.",
     "illustrative": true},
    {"@id": "cv:Rule/UKGDPR-15", "@type": "RegulatoryRule", "name": "UK GDPR Article 15 subject access and data protection complaints",
     "description": "Data subject access requests must be fulfilled within one month. Data and privacy concerns must be reviewed by the Data Protection Officer.",
     "dsarLimitDays": 30, "illustrative": true},
    {"@id": "cv:Rule/FEE-POLICY", "@type": "PolicyRule", "name": "Clearview Fees and Charges Policy",
     "description": "A fee is valid only once per event. Duplicate charges, fees applied after account closure request, fees without contractual basis must be refunded in full. Wrong fee, double charge, duplicate fee."},
    {"@id": "cv:Rule/ATM-POLICY", "@type": "PolicyRule", "name": "ATM and payment failure policy",
     "description": "If the account is debited and the ATM dispensed less than the debit, refund the difference. Failed payments debited without delivery are refunded. ATM shortfall."},
    {"@id": "cv:Rule/MORTGAGE-POLICY", "@type": "PolicyRule", "name": "Mortgage and loan dispute policy",
     "description": "Fees and charges on mortgage and loan accounts are refundable only where invalid under contract. Valid contractual charges are not upheld."},
    {"@id": "cv:Rule/CLOSURE-POLICY", "@type": "PolicyRule", "name": "Account closure and switching policy",
     "description": "Closure requests must complete within seven days. Fees charged after the closure request are refundable. Delays upheld with compensation. Switching, still open."},
    {"@id": "cv:Rule/VULNERABLE-POLICY", "@type": "PolicyRule", "name": "Vulnerable customer hard-stop policy",
     "description": "Any vulnerable marker forces priority P1, a visible alert and mandatory human review. Cannot be bypassed by confidence or STP."},
    {"@id": "cv:Rule/STP-POLICY", "@type": "PolicyRule", "name": "Straight-through-processing policy",
     "description": "STP allowed only when confidence is at least 0.90, redress at most 150 GBP, outcome is not reject, not vulnerable, no legal threat and not a data privacy complaint.",
     "stpConfidence": 0.90, "hitlRedressLimit": 150},

    {"@id": "cv:Intent/DUPLICATE_CHARGE", "@type": "Intent", "name": "Duplicate charges and wrong fees", "share": 0.28,
     "description": "Customer disputes a duplicate charge, double fee, overdraft fee or wrong fee on their account.",
     "keywords": ["charged twice", "double charged", "duplicate", "wrong fee", "unfair fee", "overdraft fee", "monthly fee", "fee", "charged me", "charge"],
     "defaultPriority": "P3", "routesTo": {"@id": "cv:Team/FEES"},
     "governedBy": [{"@id": "cv:Rule/FEE-POLICY"}, {"@id": "cv:Rule/DISP-1.6"}],
     "evidenceFrom": [{"@id": "cv:System/T24"}, {"@id": "cv:System/VERINT"}]},
    {"@id": "cv:Intent/ATM_PAYMENT_FAILURE", "@type": "Intent", "name": "ATM and payment failures", "share": 0.22,
     "description": "Cash machine did not dispense cash but account was debited, or a payment failed yet money left the account.",
     "keywords": ["atm", "cash machine", "did not dispense", "didn't dispense", "no cash", "payment failed", "declined", "cash not received", "short of cash", "cash"],
     "defaultPriority": "P2", "routesTo": {"@id": "cv:Team/PAYMENTS"},
     "governedBy": [{"@id": "cv:Rule/ATM-POLICY"}, {"@id": "cv:Rule/DISP-1.6"}],
     "evidenceFrom": [{"@id": "cv:System/T24"}, {"@id": "cv:System/CAMS"}]},
    {"@id": "cv:Intent/UNAUTHORISED_TXN", "@type": "Intent", "name": "Unauthorised transactions", "share": 0.18,
     "description": "Customer reports transactions they did not make or authorise: fraud, scam, stolen card.",
     "keywords": ["unauthorised", "unauthorized", "did not make", "didn't make", "fraud", "fraudulent", "stolen", "scam", "not me", "don't recognise", "unrecognised", "transaction i did not"],
     "defaultPriority": "P1", "routesTo": {"@id": "cv:Team/FRAUD"},
     "governedBy": [{"@id": "cv:Rule/PSR-2017-76"}, {"@id": "cv:Rule/DISP-1.6"}],
     "evidenceFrom": [{"@id": "cv:System/T24"}, {"@id": "cv:System/CAMS"}, {"@id": "cv:System/SFDC"}]},
    {"@id": "cv:Intent/MORTGAGE_LOAN_DISPUTE", "@type": "Intent", "name": "Mortgage and loan disputes", "share": 0.15,
     "description": "Dispute on mortgage or personal loan: fees, interest, early repayment charge, arrears handling.",
     "keywords": ["mortgage", "loan", "interest rate", "arrears", "early repayment charge", "redemption", "repayment", "lender"],
     "defaultPriority": "P2", "routesTo": {"@id": "cv:Team/LENDING"},
     "governedBy": [{"@id": "cv:Rule/MORTGAGE-POLICY"}, {"@id": "cv:Rule/DISP-1.6"}],
     "evidenceFrom": [{"@id": "cv:System/T24"}, {"@id": "cv:System/SFDC"}]},
    {"@id": "cv:Intent/ACCOUNT_CLOSURE", "@type": "Intent", "name": "Account closure and switching", "share": 0.10,
     "description": "Customer asked to close or switch an account and it was delayed or still open and charged.",
     "keywords": ["close my account", "closure", "closing", "switch", "switching", "still open", "cancel my account", "closed", "close"],
     "defaultPriority": "P3", "routesTo": {"@id": "cv:Team/RETENTION"},
     "governedBy": [{"@id": "cv:Rule/CLOSURE-POLICY"}, {"@id": "cv:Rule/DISP-1.6"}],
     "evidenceFrom": [{"@id": "cv:System/SFDC"}, {"@id": "cv:System/T24"}]},
    {"@id": "cv:Intent/DATA_PRIVACY", "@type": "Intent", "name": "Data and privacy concerns", "share": 0.07,
     "description": "Concerns about personal data, subject access request delays, data shared without consent, data breach.",
     "keywords": ["data", "privacy", "gdpr", "personal information", "personal data", "subject access", "dsar", "shared my details", "data breach", "my details"],
     "defaultPriority": "P2", "routesTo": {"@id": "cv:Team/DPO"},
     "governedBy": [{"@id": "cv:Rule/UKGDPR-15"}, {"@id": "cv:Rule/DISP-1.6"}],
     "evidenceFrom": [{"@id": "cv:System/SFDC"}, {"@id": "cv:System/VERINT"}]},

    {"@id": "cv:Team/FEES", "@type": "Team", "name": "Fees and Charges Resolution"},
    {"@id": "cv:Team/PAYMENTS", "@type": "Team", "name": "Payments and ATM Operations"},
    {"@id": "cv:Team/FRAUD", "@type": "Team", "name": "Fraud and Disputes"},
    {"@id": "cv:Team/LENDING", "@type": "Team", "name": "Lending Complaints"},
    {"@id": "cv:Team/RETENTION", "@type": "Team", "name": "Account Servicing and Retention"},
    {"@id": "cv:Team/DPO", "@type": "Team", "name": "Data Protection Office"},

    {"@id": "cv:Vulnerability/HEALTH_PHYSICAL", "@type": "VulnerabilityMarker", "name": "Physical health condition", "driver": "health",
     "keywords": ["disabled", "disability", "chronic illness", "wheelchair", "terminal", "cancer"]},
    {"@id": "cv:Vulnerability/HEALTH_MENTAL", "@type": "VulnerabilityMarker", "name": "Mental health condition", "driver": "health",
     "keywords": ["depression", "anxiety", "mental health", "panic attack", "suicidal"]},
    {"@id": "cv:Vulnerability/COGNITIVE", "@type": "VulnerabilityMarker", "name": "Cognitive impairment", "driver": "health",
     "keywords": ["dementia", "alzheimer", "memory loss", "cognitive", "confused easily"]},
    {"@id": "cv:Vulnerability/SENSORY", "@type": "VulnerabilityMarker", "name": "Sensory impairment", "driver": "health",
     "keywords": ["blind", "partially sighted", "deaf", "hard of hearing", "hearing impaired"]},
    {"@id": "cv:Vulnerability/BEREAVEMENT", "@type": "VulnerabilityMarker", "name": "Bereavement", "driver": "life_event",
     "keywords": ["bereaved", "bereavement", "my husband died", "my wife died", "passed away", "recently widowed", "funeral"]},
    {"@id": "cv:Vulnerability/RELATIONSHIP", "@type": "VulnerabilityMarker", "name": "Relationship breakdown or domestic abuse", "driver": "life_event",
     "keywords": ["domestic abuse", "abusive partner", "divorce", "separation", "coercive"]},
    {"@id": "cv:Vulnerability/JOB_LOSS", "@type": "VulnerabilityMarker", "name": "Job loss or income shock", "driver": "life_event",
     "keywords": ["lost my job", "made redundant", "redundancy", "unemployed", "lost my income"]},
    {"@id": "cv:Vulnerability/CARER", "@type": "VulnerabilityMarker", "name": "Caring responsibilities", "driver": "life_event",
     "keywords": ["i am a carer", "i care for", "caring for my", "full-time carer"]},
    {"@id": "cv:Vulnerability/FINANCIAL_DIFFICULTY", "@type": "VulnerabilityMarker", "name": "Financial difficulty and low resilience", "driver": "resilience",
     "keywords": ["can't afford", "cannot afford", "struggling to pay", "debt", "food bank", "can't pay my rent", "cannot pay my rent"]},
    {"@id": "cv:Vulnerability/LOW_LITERACY", "@type": "VulnerabilityMarker", "name": "Low financial literacy or language barrier", "driver": "capability",
     "keywords": ["don't understand", "english is not my first language", "cannot read well", "dyslexia", "dyslexic"]},
    {"@id": "cv:Vulnerability/LOW_DIGITAL", "@type": "VulnerabilityMarker", "name": "Low digital capability", "driver": "capability",
     "keywords": ["not good with computers", "cannot use the app", "no internet", "don't use online banking"]},
    {"@id": "cv:Vulnerability/ADDICTION", "@type": "VulnerabilityMarker", "name": "Addiction or gambling harm", "driver": "resilience",
     "keywords": ["gambling addiction", "addiction", "alcohol dependency", "recovering addict"]},
    {"@id": "cv:Vulnerability/AGE", "@type": "VulnerabilityMarker", "name": "Older age (75+)", "driver": "capability",
     "description": "Customer aged 75 or over, derived from date of birth in CRM KYC.", "ageThreshold": 75,
     "keywords": ["i am 80 years old", "i am an elderly"]},

    {"@id": "cv:Legal/THREAT", "@type": "LegalThreatMarker", "name": "Legal threat indicators",
     "keywords": ["solicitor", "legal action", "take you to court", "sue", "small claims", "ombudsman", "financial ombudsman", "fos", "trading standards", "lawyer"]},

    {"@id": "cv:Sentiment/LEXICON", "@type": "SentimentLexicon", "name": "Sentiment lexicon",
     "negative": ["angry", "furious", "disgusted", "appalled", "unacceptable", "outrageous", "terrible", "awful", "worst", "disgraceful", "ridiculous", "stressed", "upset", "worried", "scared", "fed up", "useless", "incompetent", "frustrated", "distressed", "shocking"],
     "positive": ["thank", "thanks", "appreciate", "grateful", "happy", "pleased", "kind", "helpful"]},

    {"@id": "cv:SLA/P1", "@type": "SLATier", "name": "P1 Urgent", "hours": 4,
     "description": "Urgent: vulnerable customers, unauthorised transactions, legal threats, deadline under 48 hours."},
    {"@id": "cv:SLA/P2", "@type": "SLATier", "name": "P2 High", "hours": 24,
     "description": "High: payment failures, mortgage disputes, data privacy, strongly negative sentiment."},
    {"@id": "cv:SLA/P3", "@type": "SLATier", "name": "P3 Normal", "hours": 72,
     "description": "Normal: fees and closure complaints."},

    {"@id": "cv:Channel/Branch", "@type": "Channel", "name": "Branch", "share": 0.22, "weight": 0.0},
    {"@id": "cv:Channel/CallCentre", "@type": "Channel", "name": "Call Centre", "share": 0.34, "weight": 0.0},
    {"@id": "cv:Channel/MobileApp", "@type": "Channel", "name": "Mobile App", "share": 0.21, "weight": 0.0},
    {"@id": "cv:Channel/Email", "@type": "Channel", "name": "Email", "share": 0.14, "weight": 0.0},
    {"@id": "cv:Channel/SocialMedia", "@type": "Channel", "name": "Social Media", "share": 0.09, "weight": 0.1,
     "description": "Public channel with reputational risk; urgency weight raises priority one level for negative sentiment."},

    {"@id": "cv:Authority/ANALYST", "@type": "AuthorityLevel", "name": "Analyst", "limitGBP": 50, "rank": 1},
    {"@id": "cv:Authority/LEAD", "@type": "AuthorityLevel", "name": "Team Lead", "limitGBP": 250, "rank": 2},
    {"@id": "cv:Authority/MANAGER", "@type": "AuthorityLevel", "name": "Manager", "limitGBP": 1000, "rank": 3},
    {"@id": "cv:Authority/EXECUTIVE", "@type": "AuthorityLevel", "name": "Complaints Executive", "limitGBP": 1000000, "rank": 4,
     "description": "Redress above manager authority must be escalated to Investigations."},

    {"@id": "cv:Redress/MINOR", "@type": "RedressBand", "name": "Minor distress and inconvenience", "amountGBP": 25, "maxRefundGBP": 100,
     "description": "Redress scale minor 25 pounds."},
    {"@id": "cv:Redress/MODERATE", "@type": "RedressBand", "name": "Moderate distress and inconvenience", "amountGBP": 200, "maxRefundGBP": 500,
     "description": "Redress scale moderate 200 pounds."},
    {"@id": "cv:Redress/SEVERE", "@type": "RedressBand", "name": "Severe distress and inconvenience", "amountGBP": 500, "maxRefundGBP": 100000000,
     "description": "Redress scale severe 500 pounds."},

    {"@id": "cv:Precedent/P-2023-0412", "@type": "Precedent", "name": "Duplicate monthly fee upheld", "intent": "DUPLICATE_CHARGE", "outcome": "uphold",
     "description": "Monthly account fee charged twice in one cycle. Refund of the duplicate plus 25 GBP. FOS agreed.", "refundGBP": 12.5, "compensationGBP": 25},
    {"@id": "cv:Precedent/P-2023-1190", "@type": "Precedent", "name": "ATM shortfall upheld", "intent": "ATM_PAYMENT_FAILURE", "outcome": "uphold",
     "description": "ATM dispensed less than debited. Difference refunded with 25 GBP compensation.", "refundGBP": 100, "compensationGBP": 25},
    {"@id": "cv:Precedent/P-2024-0077", "@type": "Precedent", "name": "Unauthorised card-not-present payments upheld", "intent": "UNAUTHORISED_TXN", "outcome": "uphold",
     "description": "High fraud score, cardholder not present, merchant on high risk list. Full refund plus 200 GBP. FOS appeal rejected.", "refundGBP": 640, "compensationGBP": 200},
    {"@id": "cv:Precedent/P-2024-0301", "@type": "Precedent", "name": "Valid mortgage fee not upheld", "intent": "MORTGAGE_LOAN_DISPUTE", "outcome": "reject",
     "description": "Early repayment charge was contractual and correctly applied. Complaint not upheld. FOS agreed.", "refundGBP": 0, "compensationGBP": 0},
    {"@id": "cv:Precedent/P-2024-0555", "@type": "Precedent", "name": "Closure delay upheld", "intent": "ACCOUNT_CLOSURE", "outcome": "uphold",
     "description": "Closure request open more than seven days; fees after request refunded plus 25 GBP.", "refundGBP": 15, "compensationGBP": 25},
    {"@id": "cv:Precedent/P-2025-0120", "@type": "Precedent", "name": "DSAR delayed upheld", "intent": "DATA_PRIVACY", "outcome": "uphold",
     "description": "Subject access request open longer than one month. Apology and 25 GBP compensation. DPO reviewed.", "refundGBP": 0, "compensationGBP": 25},
    {"@id": "cv:Precedent/SEASONAL-DEC", "@type": "Precedent", "name": "Seasonal surge pattern", "intent": "ANY", "outcome": "n/a",
     "description": "December and January complaint volume rises 40 percent. Plan capacity accordingly. High-risk merchant IDs cluster in chargebacks."}
  ]
}
